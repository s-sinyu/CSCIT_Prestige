US46 [shape=ellipse, style=filled, fillcolor="#eef3f3", label="Delete an unused category\n(US46)"];
US47 [shape=ellipse, style=filled, fillcolor="#eef3f3", label="Activate or deactivate a category\n(US47)"];
US48 [shape=ellipse, style=filled, fillcolor="#eef3f3", label="Daily, weekly and monthly reports\n(US48)"];
US49 [shape=ellipse, style=filled, fillcolor="#eef3f3", label="Export a report as CSV\n(US49)"];
}
