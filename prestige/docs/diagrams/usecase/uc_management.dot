subgraph cluster_sys { label="Prestige platform"; style=rounded; color="#2f4f4f"; fontsize=14;
US43 [shape=ellipse, style=filled, fillcolor="#eef3f3", label="Create a category\n(US43)"];
US44 [shape=ellipse, style=filled, fillcolor="#eef3f3", label="List all categories\n(US44)"];
