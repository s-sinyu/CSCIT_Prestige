# Copy to .env (never commit .env). Spring Boot reads these from the environment.
# ---- Backend ----
# Local docker-compose database (default). For Neon use:
#   jdbc:postgresql://<host>.neon.tech/<db>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/prestige
SPRING_DATASOURCE_USERNAME=prestige
SPRING_DATASOURCE_PASSWORD=prestige
SPRING_PROFILES_ACTIVE=dev
# At least 32 random characters, e.g. from: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-value-change-me-0123456789
APP_JWT_EXPIRY_HOURS=8
# Frontend origin(s) allowed to call the API (comma separated)
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
# The initial User Admin is created at first start-up from these values
APP_ADMIN_EMAIL=admin@prestige.local
APP_ADMIN_PASSWORD=Admin12345
# Password given to every generated demo account
APP_SEED_PASSWORD=Password123

# ---- Frontend (frontend/.env) ----
VITE_API_BASE_URL=http://localhost:8080
